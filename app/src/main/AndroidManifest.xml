<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Week 11: Internet permission for Open Library API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Week 10: Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Week 10: Exact alarm permission for daily reading reminder -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Week 10: Re-schedule the daily reminder after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookMate"
        tools:targetApi="31">

        <!-- Firebase Auth: Login Activity (Launcher) — email + password -->
        <activity
            android:name=".LoginActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Week 8: Main Activity — Offline reading list -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Firebase Realtime Database: live community recommendations -->
        <activity
            android:name=".CommunityActivity"
            android:exported="false" />

        <!-- Week 8: Search Activity — Online book search via API -->
        <activity
            android:name=".SearchActivity"
            android:exported="false" />

        <!-- Week 8: Book Detail Activity — View details, save, share -->
        <activity
            android:name=".BookDetailActivity"
            android:exported="false" />

        <!-- Reader Activity — Direct reading experience -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false" />

        <!-- Provider-hosted sign-in and verified online book loans -->
        <activity
            android:name=".BorrowActivity"
            android:exported="false" />

        <!-- Quotes & Notes — saved passages and lessons (SQLite) -->
        <activity
            android:name=".QuotesActivity"
            android:exported="false" />

        <!-- Week 10: BroadcastReceiver for daily reading reminder -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Week 10: BroadcastReceiver that restores the reminder after reboot -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Week 10: Simple started Service for background tasks -->
        <service
            android:name=".BookService"
            android:exported="false" />

    </application>

</manifest>
