<?xml version="1.0" encoding="utf-8"?>
<!-- Week 8: BookDetailActivity layout — View & manage a single book -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:animateLayoutChanges="true"
    tools:context=".BookDetailActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:elevation="4dp"
        app:title="Book Details"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@android:color/white"
        app:popupTheme="@style/ThemeOverlay.BookMate.PopupMenu" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:animateLayoutChanges="true">

            <!-- Book Title -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Book Title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp" />

            <!-- Author -->
            <TextView
                android:id="@+id/tvDetailAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="by Author Name"
                android:textSize="18sp"
                android:textColor="#FF555555"
                android:layout_marginBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginBottom="16dp" />

            <!-- Publication Year -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Published: "
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvDetailYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N/A"
                    android:textSize="15sp"
                    android:textColor="#FF555555" />

            </LinearLayout>

            <!-- Publisher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publisher: "
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/tvDetailPublisher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N/A"
                    android:textSize="15sp"
                    android:textColor="#FF555555" />

            </LinearLayout>

            <!-- Status badge & Reading Progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:animateLayoutChanges="true">

                <TextView
                    android:id="@+id/tvDetailStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_badge"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDetailReadingProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:background="@drawable/bg_edit_text"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ✨ AI BOOK SUMMARY CARD (Gemini 2.5) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#F8FAFC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Row: Icon, Title, Badge, Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_auto_awesome"
                            app:tint="@color/brand_primary"
                            android:contentDescription="AI Summary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI Overview"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1A202C" />

                        <TextView
                            android:id="@+id/tvAiBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="Gemini 2.5"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_primary"
                            android:background="@drawable/bg_badge" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- TTS Aloud Button -->
                        <ImageButton
                            android:id="@+id/btnAiTts"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_volume_up"
                            app:tint="@color/brand_primary"
                            android:contentDescription="Listen to Summary" />

                        <!-- Refresh/Regenerate Button -->
                        <ImageButton
                            android:id="@+id/btnAiRefresh"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_refresh"
                            app:tint="#64748B"
                            android:contentDescription="Regenerate Summary" />

                    </LinearLayout>

                    <!-- Loading Progress -->
                    <LinearLayout
                        android:id="@+id/layoutAiLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Generating summary with Gemini 2.5..."
                            android:textSize="13sp"
                            android:textColor="#64748B" />

                    </LinearLayout>

                    <!-- Summary Content Body -->
                    <TextView
                        android:id="@+id/tvAiSummaryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#334155"
                        android:lineSpacingMultiplier="1.3" />

                    <!-- Divider separating Summary from Chat -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="#E2E8F0" />

                    <!-- 💬 AI Book Chat Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/brand_primary"
                            android:contentDescription="Chat with AI" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Ask BookMate AI"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A202C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnClearAiChat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear"
                            android:textSize="11sp"
                            android:textColor="#94A3B8"
                            android:padding="4dp"
                            android:visibility="gone"
                            android:background="?attr/selectableItemBackground" />
                    </LinearLayout>

                    <!-- Quick Prompt Suggestion Chips -->
                    <HorizontalScrollView
                        android:id="@+id/scrollAiChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chipGenre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎭 Genre?"
                                android:textSize="12sp"
                                android:textColor="#475569"
                                android:background="@drawable/bg_chat_chip"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/chipPages"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📄 Page count?"
                                android:textSize="12sp"
                                android:textColor="#475569"
                                android:background="@drawable/bg_chat_chip"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/chipCharacters"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👥 Main characters?"
                                android:textSize="12sp"
                                android:textColor="#475569"
                                android:background="@drawable/bg_chat_chip"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/chipPlot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="❓ What happens to..."
                                android:textSize="12sp"
                                android:textColor="#475569"
                                android:background="@drawable/bg_chat_chip"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Chat Messages Stream (Dynamic Question & Answer Bubbles) -->
                    <LinearLayout
                        android:id="@+id/layoutAiChatMessages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:animateLayoutChanges="true" />

                    <!-- Chat Thinking / Loading Row -->
                    <LinearLayout
                        android:id="@+id/layoutAiChatLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gemini 2.5 is thinking..."
                            android:textSize="12sp"
                            android:textColor="#64748B" />
                    </LinearLayout>

                    <!-- Chat Input Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/etAiChatQuestion"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_bar"
                            android:hint="Ask genre, pages, characters..."
                            android:textSize="13sp"
                            android:textColor="#1E293B"
                            android:textColorHint="#94A3B8"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:imeOptions="actionSend"
                            android:inputType="textCapSentences"
                            android:maxLines="2" />

                        <ImageButton
                            android:id="@+id/btnAiChatSend"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_send"
                            app:tint="@color/brand_primary"
                            android:contentDescription="Send Question" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PRIMARY ACTION: Read Book Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReadBook"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Read Book"
                app:icon="@drawable/ic_menu_book"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:elevation="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBorrowOnline"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/loan_borrow_read"
                android:visibility="gone"
                app:cornerRadius="12dp" />

            <!-- Secondary Actions: Save / Finish / Delete -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveWantToRead"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="Save to Reading List"
                app:icon="@drawable/ic_bookmark"
                app:iconGravity="textStart"
                app:iconTint="?attr/colorPrimary"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveFinished"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="Mark as Finished"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconTint="@color/badge_finished"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="Delete from Library"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="#FFD32F2F"
                android:textColor="#FFD32F2F"
                android:textSize="14sp"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginBottom="8dp" />

            <!-- Share button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Share Recommendation"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconTint="?attr/colorPrimary"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <!-- Realtime Database: recommend this book to the community -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecommend"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Recommend to Community"
                app:icon="@drawable/ic_public"
                app:iconGravity="textStart"
                app:iconTint="@color/brand_accent_dark"
                android:textColor="@color/brand_accent_dark"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
