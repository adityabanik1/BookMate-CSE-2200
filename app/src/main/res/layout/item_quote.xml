<?xml version="1.0" encoding="utf-8"?>
<!-- Week 9: RecyclerView item layout for a saved quote (same card style as item_book.xml) -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- The quote itself -->
        <TextView
            android:id="@+id/tvQuoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="“Quote text”"
            android:textSize="15sp"
            android:textStyle="italic"
            android:textColor="@android:color/black"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="6"
            android:ellipsize="end" />

        <!-- Book: "— Title, Author" (hidden if there's no book) -->
        <TextView
            android:id="@+id/tvQuoteSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="— Book Title, Author"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Personal note / lesson (hidden if empty) -->
        <TextView
            android:id="@+id/tvQuoteNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="📝 Note"
            android:textSize="13sp"
            android:textColor="#FF666666"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Date saved -->
        <TextView
            android:id="@+id/tvQuoteDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Saved 1 Jan 2026"
            android:textSize="11sp"
            android:textColor="#FF999999" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
