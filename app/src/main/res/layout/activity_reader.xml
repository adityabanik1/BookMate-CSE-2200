<?xml version="1.0" encoding="utf-8"?>
<!-- ReaderActivity layout — Distraction-free native reading with appearance controls & in-app webview -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutReaderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".ReaderActivity">

    <!-- Top App Bar with back navigation, TTS button, and theme switcher -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarReader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Reading"
        app:titleTextColor="@android:color/white"
        app:subtitleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@android:color/white">

        <!-- Mode Toggle & Action Buttons inside Toolbar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="8dp">

            <!-- Find in book (🔍) -->
            <ImageButton
                android:id="@+id/btnFind"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Find in book"
                app:tint="@android:color/white" />

            <!-- Text-to-Speech (TTS) Button -->
            <ImageButton
                android:id="@+id/btnTts"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:contentDescription="Listen to Book (Text-to-Speech)"
                app:tint="@android:color/white" />

            <!-- Theme Switcher (White / Dark / Sepia) -->
            <ImageButton
                android:id="@+id/btnThemeToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dark_mode"
                android:contentDescription="Switch Reading Theme"
                app:tint="@android:color/white" />

            <!-- Web / Text Mode Toggle (shown if online link available) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleMode"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:textColor="@android:color/white"
                android:text="Web View"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:id="@+id/layoutOnlineNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Some editions offer previews only. Check the book page for full access or borrowing options."
            android:textColor="#333333"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenWebsite"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open in browser"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Reading Progress Bar (Thin line right below the toolbar) -->
    <ProgressBar
        android:id="@+id/progressBarReading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="0"
        android:max="100"
        android:progressTint="?attr/colorSecondary"
        android:progressBackgroundTint="#33000000" />

    <!-- Container holding either Native Text or In-App WebView -->
    <FrameLayout
        android:id="@+id/containerContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Native Reader View -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollReader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/layoutBookTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="48dp">

                <!-- Header: Book Title & Author -->
                <TextView
                    android:id="@+id/tvReaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Book Title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvReaderAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="by Author"
                    android:textSize="15sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="16dp" />

                <!-- Divider -->
                <View
                    android:id="@+id/dividerReader"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="20dp" />

                <!-- Book Body Content -->
                <TextView
                    android:id="@+id/tvReaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading book content..."
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.4"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:textColor="#222222"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- In-App WebView for Online Reader (Internet Archive / Open Library) -->
        <WebView
            android:id="@+id/webViewReader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Loading Indicator for Background Book Text Download -->
        <ProgressBar
            android:id="@+id/progressBarLoadingText"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Sections keep long books readable without one oversized TextView. -->
    <LinearLayout
        android:id="@+id/layoutSectionControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviousSection"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Previous" />

        <TextView
            android:id="@+id/tvSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#333333"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextSection"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next" />
    </LinearLayout>

    <!-- Bottom Appearance & Progress Controls Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#F5F5F5">

        <!-- Interactive Font Size Stepper Capsule -->
        <LinearLayout
            android:id="@+id/layoutFontSizeCapsule"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_stepper_capsule"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Font Decrease Button (-) -->
            <ImageButton
                android:id="@+id/btnFontDecrease"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_text_decrease"
                android:contentDescription="Decrease font size"
                android:scaleType="centerInside" />

            <!-- Font Size Indicator -->
            <TextView
                android:id="@+id/tvFontSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="16 sp"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#1E293B" />

            <!-- Font Increase Button (+) -->
            <ImageButton
                android:id="@+id/btnFontIncrease"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_text_increase"
                android:contentDescription="Increase font size"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Quick Dark/White Theme Toggle in Bottom Bar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeQuickToggle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:text="🌙 Dark"
            android:textSize="12sp"
            android:textColor="#334155"
            app:cornerRadius="18dp" />

        <!-- Reading Progress Text Percentage -->
        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0% read"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#555555" />

    </LinearLayout>

</LinearLayout>
