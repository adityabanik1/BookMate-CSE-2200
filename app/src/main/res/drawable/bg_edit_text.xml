<?xml version="1.0" encoding="utf-8"?>
<!-- Interactive state-list background for EditTexts across the app -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: highlighted brand outline -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1.5dp" android:color="@color/brand_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Default state: soft neutral background with light border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF8F8FA" />
            <stroke android:width="1dp" android:color="#FFE2E4E9" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
